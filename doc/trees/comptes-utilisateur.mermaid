flowchart TD
    intro["Identifier compte à analyser"]
    start["Accès au site internet ?"]
    account_new_password["Demander nouveau mot de passe"]
    account_need["Besoin de ce compte ?"]
    type_compte["Type de compte ?"]
    abonnement_need["Encore abonné ?"]
    service_need["Encore besoin du service ?"]
    ecommerce_need["Commande récente (6 mois) ?"]
    ecommerce_current_order["Commande en cours ?"]
    ecommerce_sav["SAV/garantie liée au compte ?"]
    ecommerce_loyalty["Avantages fidélité intéressants ?"]
    email_check["Email utilisé sur plusieurs comptes ?"]
    email_update["Changer l'email"]
    password_check["Mot de passe réutilisé ?"]
    password_complex["Mot de passe assez complexe ?"]
    password_since["Changé il y a moins d'un an ?"]
    password_update["Changer le mot de passe"]
    payment_check["Moyen de paiement enregistré ?"]
    payment_set_card["Retirer l'IBAN ?"]
    payment_clear_cards["Retirer les cartes ?"]
    payment_card_limited["Carte virtuelle limitée"]
    mfa_check["Double authentification dispo ?"]
    mfa_enable["Activer la 2FA par appli"]
    hibp_register["Inscrire l'email sur HIBP"]
    account_get_infos["Récupérer infos du compte"]
    account_did_mfa["2FA par appli activée ?"]
    account_delete_from_ui["Suppression possible depuis le site ?"]
    account_find_info_without_access["Chercher infos sans accès"]
    account_without_access_did_mfa["Entrée 2FA dans l'appli ?"]
    delete_rgpd_find_dpo["Chercher email du DPO"]
    delete_rgpd_email["Envoyer l'email RGPD"]
    c_secured(["Compte sécurisé"])
    c_need_advice(["J'ai besoin d'aide"])
    c_deleted(["Compte supprimé"])
    c_u_next_time(["À bientôt"])

    intro -->|"Compte identifié"| start
    intro -->|"Pas le temps"| c_u_next_time
