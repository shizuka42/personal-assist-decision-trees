flowchart TD
    intro["Préparer l'alerte reçue"]
    source["Comment as-tu appris la fuite ?"]
    verify_message["Alerte authentique ?"]
    hibp_check["Email présent dans HIBP"]
    unknown_service["Service inconnu : chercher l'origine"]
    service_check["Client du service cité ?"]
    check_concerned["Suis-je concerné ?"]
    data_which["Quelles données concernées ?"]
    data_unknown["Liste des données inconnue"]
    card_check["Carte bancaire concernée ?"]
    card_action["Surveiller les opérations bancaires"]
    iban_check["IBAN concerné ?"]
    iban_action["Surveiller prélèvements et mandats SEPA"]
    password_check["Mot de passe concerné ?"]
    password_where["Changer le mot de passe du compte"]
    password_reuse["Mot de passe réutilisé ailleurs ?"]
    password_reuse_action["Changer les autres mots de passe"]
    mfa_leak["Activer la double authentification"]
    id_check["Pièce d'identité concernée ?"]
    id_action["Surveiller l'usurpation d'identité"]
    health_check["N° sécu ou santé concernés ?"]
    health_action["Sécuriser les comptes santé"]
    personal_check["Coordonnées concernées ?"]
    email_leak["Sécuriser la boîte mail"]
    hibp_notify["Inscrire l'email sur HIBP"]
    phishing_vigilance["Rester vigilant face aux arnaques"]
    service_account_future["Compte encore utile ?"]
    c_secured_after_leak(["Fuite traitée"])
    c_delete_account(["Supprimer ce compte"])
    c_not_concerned(["Pas concerné"])
    c_fake_message(["Faux message d'alerte"])
    c_fraud(["Opérations bancaires suspectes"])
    c_identity_theft(["Usurpation d'identité"])
    c_blackmail(["Chantage"])
    c_account_hijacked(["Compte piraté"])
    c_clicked(["J'ai cliqué ou donné des infos"])
    c_need_advice(["J'ai besoin d'aide"])
    c_u_next_time(["À bientôt"])

    intro -->|"Alerte sous les yeux"| source
    intro -->|"Pas le temps"| c_u_next_time
    source -->|"Alerte HIBP"| hibp_check
    source -->|"Message du service"| verify_message
    source -->|"Presse ou réseaux sociaux"| service_check
    verify_message -->|"Fuite confirmée"| data_which
    verify_message -->|"Faux message"| c_fake_message
    verify_message -->|"Vérification impossible"| c_need_advice
    hibp_check -->|"Service reconnu"| data_which
    hibp_check -->|"Service inconnu"| unknown_service
    unknown_service -->|"Traces retrouvées"| data_which
    unknown_service -->|"Rien, je continue"| data_which
    service_check -->|"Client du service"| data_which
