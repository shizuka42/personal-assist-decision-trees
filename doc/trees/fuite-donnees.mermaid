    classDef question fill:#eef2ff,stroke:#6366f1,color:#1e1b4b
    classDef ok fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef help fill:#fef3c7,stroke:#d97706,color:#78350f
    classDef danger fill:#fee2e2,stroke:#dc2626,color:#7f1d1d
    class intro,source,verify_message,hibp_check,unknown_service,service_check,check_concerned,data_which,data_unknown,card_check,card_action,iban_check,iban_action,password_check,password_where,password_reuse,password_reuse_action,mfa_leak,id_check,id_action,health_check,health_action,personal_check,email_leak,hibp_notify,phishing_vigilance,service_account_future question
